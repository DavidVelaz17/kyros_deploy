# Copia este archivo a .env y ajusta los valores reales antes de levantar el stack.
# .env está en .gitignore: nunca subas credenciales reales al repo.

# --- Dominio / Caddy ---
# Un dominio real (con su DNS ya apuntando a la IP del servidor) -> HTTPS automático.
# ":80" -> HTTP plano sin TLS, para probar todo el stack en tu máquina antes de tener servidor/dominio.
DOMAIN=:80

# --- Datos persistentes (MySQL y fotos de alumnos) ---
# En el servidor: la ruta donde ya montaste tu volumen de Hetzner (ej. /mnt/kyros-data). En tu
# Mac, déjalo sin definir — cae en ./data (carpeta local, ya en .gitignore).
# DATA_DIR=/mnt/kyros-data

# false SOLO junto con DOMAIN=:80 (sin HTTPS) — si no, el login se ve exitoso pero la cookie de
# sesión nunca se guarda y cualquier clic te regresa a /login. Con un dominio real (HTTPS), deja
# esto en true o quítalo (true es el default).
COOKIE_SECURE=false

# --- Base de datos ---
# Usuario dedicado para la app (NO root) — mejor práctica: si la app se ve comprometida, no tiene
# permisos de administración sobre MySQL.
DB_NAME=demokyros
DB_USERNAME=demokyros
DB_PASSWORD=change-me
# Password del usuario root de MySQL (administración), distinto del de la app.
MYSQL_ROOT_PASSWORD=change-me

# --- Backend ---
# Genera un valor aleatorio de al menos 32 bytes: openssl rand -base64 32
JWT_SECRET=change-me-min-32-bytes-random-secret
JWT_EXPIRATION_MINUTES=720
# En producción, lista tu dominio real separado por comas si hay más de uno.
# Con DOMAIN=:80 (prueba local) puedes dejarlo en *.
CORS_ALLOWED_ORIGINS=https://tudominio.com
